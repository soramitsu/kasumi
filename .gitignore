# Cargo build output, including builds from vendored crates
debug/
target/

# Local benchmark checkout links
/*-native-???????

# Default local benchmark output; reviewed result cohorts remain tracked
/kasumi-benchmark.json
/benchmarks/results/network-loopback-*.json
/benchmarks/results/local/
*.json.tmp

# Development evidence is a local archive; keep only the retention policy
/docs/evidence/*
!/docs/evidence/README.md

# OpenRaft integration tests write trace logs beside their fixtures
/vendor/openraft-*/tests/_log/

# Local credentials and deployment configuration
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
.aws/
.ssh/
.secrets/
secrets/
credentials.json
credentials-*.json
service-account*.json

# Python benchmark and release helpers
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Dependencies used by JavaScript integration fixtures
node_modules/

# Local tool caches and environment state
.cache/
.direnv/

# Coverage and profiling output
.coverage
.coverage.*
htmlcov/
/coverage/
*.profraw
*.profdata

# Ad hoc root command logs
/*.log

# Local scratch and editor files
/tmp/
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/
