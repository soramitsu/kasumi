+    pub(crate) fn accepted_failure_transfer(&self, transfer: &FailedFileTransfer) -> bool {
+        if !std::ptr::eq(self, Arc::as_ptr(&transfer.disk)) {
+            return false;
+        }
+        let Ok(state) = self.state.try_lock() else {
+            return false;
