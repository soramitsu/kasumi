+mod tests {
+    use super::*;
+    use crate::BackendNativeDisposition;
+
+    #[test]
+    fn explicit_close_drains_the_native_file_once_and_fences_io() {
+        let backend = FileBackend::new(tempfile::tempfile().unwrap()).unwrap();
+        assert_eq!(backend.len().unwrap(), 0);
