+    registration: usize,
+    slot: usize,
+    attempt: u64,
+    identity: Identity,
+}
+
+/// Receipt of a transfer into the already admitted fixed custody bank. Transfer
+/// releases no registration, physical extent, original outcome or memory charge.
+pub(crate) struct FailedFileTransfer {
