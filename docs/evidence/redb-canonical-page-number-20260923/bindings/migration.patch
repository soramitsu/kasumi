+        let mut bytes = vec![0; 8 + 24 * children.len() + 16];
+        bytes[0] = BRANCH;
+        bytes[2..4].copy_from_slice(&2_u16.to_le_bytes());
+        for (index, child) in children.iter().enumerate() {
