+        source.memory_mut().fill(0);
+        source.memory_mut()[0] = BRANCH;
+        source.memory_mut()[2..4].copy_from_slice(&1_u16.to_le_bytes());
+        source.memory_mut()[40..48].copy_from_slice(&PageNumber::new(0, 0, 0).to_le_bytes());
