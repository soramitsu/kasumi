+        Database::create(file.path(), owner.clone()),
+        Err(DatabaseError::Storage(StorageError::CapacityDenied))
+    ));
+    assert_eq!(file.as_file().metadata().unwrap().len(), 0);
+    assert_eq!(owner.failures.load(Ordering::Relaxed), 0);
