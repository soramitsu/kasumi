+    {
+        let txn = db.begin_write().unwrap();
+        {
+            let mut table = txn.open_table(TABLE).unwrap();
+            for k in 0..5u64 {
+                let v = vec![(k as u8).wrapping_add(0xA0); 64];
+                table.insert(&k, v.as_slice()).unwrap();
