+                    .map(|(_, errno)| io::Error::from_raw_os_error(errno))
+            })
+    }
+    fn failure_projection(&self) -> Option<io::Error> {
+        self.close_projection().or_else(|| {
+            self.original_error.as_ref().and_then(|mutex| {
