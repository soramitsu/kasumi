+            let mut table = change.open_table(DATA).unwrap();
+            for key in 0..BASE_ROWS / 2 {
+                table.remove(key).unwrap();
+            }
+        }
+        change.commit().unwrap();
+        assert_eq!(pinned.open_table(DATA).unwrap().len().unwrap(), BASE_ROWS);
+        assert_eq!(
+            pinned
+                .open_table(DATA)
+                .unwrap()
+                .get(0)
+                .unwrap()
+                .unwrap()
+                .value(),
+            VALUE
+        );
+        drop(pinned);
+        let mut maintenance = db.begin_write().unwrap();
+        maintenance.set_quick_repair(quick_repair);
+        maintenance.post_commit_free = super::PostCommitFree::Disabled;
+        maintenance.commit().unwrap();
+        drop(db);
+
+        let mut reopened = reopen(&path, SPLIT_REGION_BYTES);
+        assert!(reopened.check_integrity().unwrap());
+        let read = reopened.begin_read().unwrap();
+        let table = read.open_table(DATA).unwrap();
+        assert_eq!(table.len().unwrap(), BASE_ROWS / 2);
+        for key in 0..BASE_ROWS {
+            let value = table.get(key).unwrap();
+            if key < BASE_ROWS / 2 {
+                assert!(value.is_none());
+            } else {
+                assert_eq!(value.unwrap().value(), VALUE);
+            }
+        }
+    }
+}
