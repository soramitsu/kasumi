index 0000000..473d1b6
--- /dev/null
+++ b/src/tree_store/page_store/allocator_commit.rs
@@ -0,0 +1,190 @@
+use super::buddy_allocator::BuddyAllocator;
+use super::layout::DatabaseLayout;
+use super::region::{Allocators, RegionTracker};
+use crate::tree_store::PageNumber;
+use alloc::collections::BTreeMap;
+use core::cmp::min;
+
+// The exclusive borrow pins the exact allocator state used by preparation. Only changed
+// regions are copied; dropping a candidate leaves every live bitmap unchanged.
+pub(super) struct AllocatorCommitCandidate<'a> {
+    live: &'a mut Allocators,
+    regions: BTreeMap<u32, BuddyAllocator>,
+    tracker: RegionTracker,
+    region_count: usize,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::AllocatorCommitCandidate;
+    use crate::tree_store::PageNumber;
+    use crate::tree_store::page_store::buddy_allocator::BuddyAllocator;
+    use crate::tree_store::page_store::layout::{DatabaseLayout, RegionLayout};
+    use crate::tree_store::page_store::region::Allocators;
+
+    fn fixture() -> (Allocators, DatabaseLayout, [PageNumber; 3]) {
+        let region = RegionLayout::new(16, 0, 512);
+        let layout = DatabaseLayout::new(3, region, None);
+        let mut live = Allocators::new(layout);
+        let pages = [
+            PageNumber {
+                region: 0,
+                page_index: 0,
+                page_order: 2,
+            },
+            PageNumber {
+                region: 0,
+                page_index: 1,
+                page_order: 2,
+            },
+            PageNumber {
+                region: 1,
+                page_index: 0,
+                page_order: 0,
+            },
+        ];
+        for page in pages {
+            assert!(
+                live.region_allocators[page.region as usize]
+                    .record_alloc(page.page_index, page.page_order)
+            );
+        }
+        (live, layout, pages)
+    }
+
+    #[test]
+    fn discard_preserves_live_allocator_and_only_copies_changed_regions() {
+        let (mut live, _, pages) = fixture();
+        let hash = live.xxh3_hash();
+        let tracker = live.region_tracker.to_vec();
+        {
+            let candidate = AllocatorCommitCandidate::new(&mut live, &pages[..2]);
+            assert_eq!(candidate.regions.len(), 1);
+            assert_eq!(candidate.live.xxh3_hash(), hash);
+            assert_eq!(candidate.live.region_tracker.to_vec(), tracker);
+            assert_eq!(candidate.region(0).count_free_pages(), 16);
+        }
+        assert_eq!(live.xxh3_hash(), hash);
+        assert_eq!(live.region_tracker.to_vec(), tracker);
+        // A dropped candidate cannot make either retired block reusable.
+        assert!(!live.region_allocators[0].record_alloc(0, 2));
+        assert!(!live.region_allocators[0].record_alloc(1, 2));
+    }
+
+    #[test]
+    fn publication_matches_prepared_quick_repair_bytes_and_preserves_other_pages() {
+        let (mut live, _, pages) = fixture();
+        let candidate = AllocatorCommitCandidate::new(&mut live, &pages[..2]);
+        let prepared = candidate.region(0).to_vec();
+        let tracker = candidate.tracker().to_vec();
+        let untouched = candidate.region(1).to_vec();
+        let mut decoded = BuddyAllocator::from_bytes(&prepared);
+        assert!(decoded.record_alloc(0, 3));
+        candidate.publish();
+        assert_eq!(live.region_allocators[0].to_vec(), prepared);
+        assert_eq!(live.region_tracker.to_vec(), tracker);
+        assert_eq!(live.region_allocators[1].to_vec(), untouched);
+        assert!(live.region_allocators[0].record_alloc(0, 3));
+        assert!(!live.region_allocators[1].record_alloc(0, 0));
+    }
+
+    #[test]
+    fn shrinking_is_private_until_publication_and_cannot_discard_live_pages() {
+        let (mut live, layout, pages) = fixture();
+        let hash = live.xxh3_hash();
+        let mut candidate = AllocatorCommitCandidate::new(&mut live, &pages[..1]);
+        let smaller = candidate.shrink(layout, true);
+        assert_eq!(smaller.num_regions(), 2);
+        assert_eq!(candidate.live.region_allocators.len(), 3);
+        assert_eq!(candidate.live.xxh3_hash(), hash);
+        drop(candidate);
+        assert_eq!(live.region_allocators.len(), 3);
+        assert_eq!(live.xxh3_hash(), hash);
+
+        let mut candidate = AllocatorCommitCandidate::new(&mut live, &[]);
+        let smaller = candidate.shrink(layout, true);
+        let smaller = candidate.shrink(smaller, true);
+        assert_eq!(smaller.num_regions(), 2);
+        assert_eq!(smaller.region_layout(1).num_pages(), 1);
+        candidate.publish();
+        assert_eq!(live.region_allocators.len(), 2);
+        assert_eq!(live.region_allocators[1].len(), 1);
+        assert!(!live.region_allocators[1].record_alloc(0, 0));
+    }
+}
+
+impl<'a> AllocatorCommitCandidate<'a> {
+    pub(super) fn new(live: &'a mut Allocators, freed: &[PageNumber]) -> Self {
+        let tracker = live.region_tracker.clone();
+        let region_count = live.region_allocators.len();
+        let mut result = Self {
+            live,
+            regions: BTreeMap::new(),
+            tracker,
+            region_count,
+        };
+        for page in freed {
+            let order = result
+                .region_mut(page.region)
+                .free(page.page_index, page.page_order);
+            result.tracker.mark_free(order, page.region);
+        }
+        result
+    }
+
+    pub(super) fn region(&self, region: u32) -> &BuddyAllocator {
+        assert!((region as usize) < self.region_count);
+        self.regions
+            .get(&region)
+            .unwrap_or(&self.live.region_allocators[region as usize])
+    }
+
+    fn region_mut(&mut self, region: u32) -> &mut BuddyAllocator {
+        assert!((region as usize) < self.region_count);
+        self.regions
+            .entry(region)
+            .or_insert_with(|| self.live.region_allocators[region as usize].clone())
+    }
+
+    pub(super) fn tracker(&self) -> &RegionTracker {
+        &self.tracker
+    }
+
+    pub(super) fn shrink(&mut self, layout: DatabaseLayout, force: bool) -> DatabaseLayout {
+        let last_region = layout.num_regions() - 1;
+        let allocator = self.region(last_region);
+        let trailing_free = allocator.trailing_free_pages();
+        let old_len = allocator.len();
+        if trailing_free == 0 || (trailing_free < old_len / 2 && !force) {
+            return layout;
+        }
+        let reduce_by = if layout.num_regions() > 1 && trailing_free == old_len {
+            trailing_free
+        } else if force {
+            min(old_len - 1, trailing_free)
+        } else {
+            trailing_free / 2
+        };
+        let mut result = layout;
+        result.reduce_last_region(reduce_by);
+        if result.num_regions() < layout.num_regions() {
+            self.regions.remove(&last_region);
+            self.tracker.mark_full(0, last_region);
+            self.region_count -= 1;
+        } else {
+            self.region_mut(last_region)
+                .resize(result.region_layout(last_region).num_pages());
+        }
+        result
+    }
+
+    // Preparation allocated every replacement. Publishing only moves owners and drops
+    // superseded storage; it cannot allocate, perform I/O, or discover capacity exhaustion.
+    pub(super) fn publish(self) {
+        for (region, allocator) in self.regions {
+            self.live.region_allocators[region as usize] = allocator;
+        }
+        self.live.region_allocators.truncate(self.region_count);
+        self.live.region_tracker = self.tracker;
+    }
+}
