+#[test]
+fn admitted_durable_publication_has_no_volatile_epilogue_or_unreserved_trim() {
+    for quick_repair in [false, true] {
+        for two_phase in [false, true] {
+            let (db, path, probe) = fixture_with_region(SPLIT_REGION_BYTES);
+            let pinned = db.begin_read().unwrap();
+            let original_len = probe.physical_len.load(Ordering::SeqCst);
+            for generation in 0..4_u8 {
+                let admission = Admission::new(probe.clone(), usize::MAX);
+                let mut tx = db
+                    .begin_write_with_growth_admission(admission.clone())
+                    .unwrap();
+                tx.set_quick_repair(quick_repair);
+                tx.set_two_phase_commit(two_phase);
+                assert!(tx.post_commit_free == super::PostCommitFree::Disabled);
+                let mem = tx.mem.clone();
+                tx.open_table(DATA)
+                    .unwrap()
+                    .insert(0, [generation; 80].as_slice())
+                    .unwrap();
+                tx.commit().unwrap();
+                assert!(!mem.has_volatile_state());
+                assert_eq!(
+                    probe.physical_len.load(Ordering::SeqCst),
+                    probe.reserved_extent.load(Ordering::SeqCst)
+                );
+                assert!(probe.physical_len.load(Ordering::SeqCst) >= original_len);
+                assert_eq!(
+                    pinned
+                        .open_table(DATA)
+                        .unwrap()
+                        .get(0)
+                        .unwrap()
+                        .unwrap()
+                        .value(),
+                    VALUE
+                );
+            }
+            drop(pinned);
+            probe.enforce.store(false, Ordering::SeqCst);
+            drop(db);
+            let mut reopened = reopen(&path, SPLIT_REGION_BYTES);
+            assert!(reopened.check_integrity().unwrap());
+            assert_eq!(
+                reopened
+                    .begin_read()
+                    .unwrap()
+                    .open_table(DATA)
+                    .unwrap()
+                    .get(0)
+                    .unwrap()
+                    .unwrap()
+                    .value(),
+                [3; 80]
+            );
+        }
+    }
