+#[test]
+fn failed_root_io_discards_allocator_candidate_without_exposing_frees() {
+    for operation in [WRITE, SYNC] {
+        let (db, path, probe) = fixture();
+        let pinned = db.begin_read().unwrap();
+        let mut change = db.begin_write().unwrap();
+        change.post_commit_free = super::PostCommitFree::Disabled;
+        change
+            .open_table(DATA)
+            .unwrap()
+            .insert(0, b"current".as_slice())
+            .unwrap();
+        change.commit().unwrap();
+        drop(pinned);
+        let mut tx = db.begin_write().unwrap();
+        let (pages, _) = tx.prepare_freed_pages(tx.transaction_id).unwrap();
+        assert!(!pages.is_empty());
+        let hash = tx.mem.allocator_hash();
+        let roots = [tx.mem.get_data_root(), tx.mem.get_system_root()];
+        probe.fail.store(operation, Ordering::SeqCst);
+        let result = tx.mem.commit(crate::tree_store::CommitRequest {
+            data_root: roots[0],
+            system_root: roots[1],
+            transaction_id: tx.transaction_id,
+            two_phase: true,
+            shrink_policy: crate::tree_store::ShrinkPolicy::Maximum,
+            freed_pages: &pages,
+            growth: &tx.growth,
+        });
+        assert!(matches!(result, Err(StorageError::Io(_))));
+        assert_eq!(tx.mem.allocator_hash(), hash);
+        drop(tx);
+        probe.fail.store(0, Ordering::SeqCst);
+        drop(db);
+        let mut reopened = reopen(&path, REGION_BYTES);
+        assert!(reopened.check_integrity().unwrap());
+        assert_eq!(
+            reopened
+                .begin_read()
+                .unwrap()
+                .open_table(DATA)
+                .unwrap()
+                .get(0)
+                .unwrap()
+                .unwrap()
+                .value(),
+            b"current"
+        );
+    }
+}
