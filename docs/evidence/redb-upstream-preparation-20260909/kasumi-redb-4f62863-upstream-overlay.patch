+fn fixture() -> (Database, tempfile::TempPath, Arc<Probe>) {
+    fixture_with_region(REGION_BYTES)
+}
+
+fn fixture_with_region(region_bytes: u64) -> (Database, tempfile::TempPath, Arc<Probe>) {
+    let (file, path) = crate::create_tempfile().into_parts();
+    let probe = Arc::new(Probe::default());
+    let db = Database::builder()
+        .set_page_size(PAGE_BYTES)
+        .set_region_size(region_bytes)
+        .set_cache_size(1024 * 1024)
+        .create_with_backend(ObservedBackend {
+            file: FileBackend::new(file).unwrap(),
+            probe: probe.clone(),
+        })
+        .unwrap();
+    let mut tx = db.begin_write().unwrap();
+    tx.disable_post_commit_free();
+    {
+        let mut table = tx.open_table(DATA).unwrap();
+        for key in 0..BASE_ROWS {
+            table.insert(key, VALUE.as_slice()).unwrap();
+        }
+        assert!(table.stats().unwrap().branch_pages() > 0);
+        tx.open_table(OTHER)
+            .unwrap()
+            .insert(0, VALUE.as_slice())
+            .unwrap();
+    }
+    tx.commit().unwrap();
+    (db, path, probe)
+}
+
+fn reopen(path: &std::path::Path, region_bytes: u64) -> Database {
+    Database::builder()
+        .set_page_size(PAGE_BYTES)
+        .set_region_size(region_bytes)
+        .open(path)
+        .unwrap()
+}
+
+fn assert_baseline(db: &Database) {
+    let read = db.begin_read().unwrap();
+    let table = read.open_table(DATA).unwrap();
+    assert_eq!(table.len().unwrap(), BASE_ROWS);
+    for key in 0..BASE_ROWS {
+        assert_eq!(table.get(key).unwrap().unwrap().value(), VALUE);
+    }
+    let other = read.open_table(OTHER).unwrap();
+    assert_eq!(other.len().unwrap(), 1);
+    assert_eq!(other.get(0).unwrap().unwrap().value(), VALUE);
+}
