+        .insert(0, b"retained".as_slice())
+        .unwrap();
+    let allocator_hash = tx.mem.allocator_hash();
+    assert!(matches!(
+        tx.restore_savepoint(&savepoint),
+        Err(crate::SavepointError::UnsupportedGrowthAdmission(
