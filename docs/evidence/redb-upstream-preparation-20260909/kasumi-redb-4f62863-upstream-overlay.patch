+fn fill_until_denied(table: &mut crate::Table<'_, u64, &[u8]>) -> CapacityExceeded {
+    for key in BASE_ROWS..INSERT_KEY_LIMIT {
+        match table.insert(key, VALUE.as_slice()) {
+            Ok(_) => {}
+            Err(StorageError::CapacityExceeded(failure)) => return failure,
+            Err(error) => panic!("unexpected mutation failure: {error}"),
+        }
+    }
+    panic!("bounded split workload did not reach its growth limit");
+}
