+fn failed_admission_owner_closes_cached_access_and_new_work_without_resizing() {
+    for explicit_commit in [false, true] {
+        let (db, path, probe) = fixture();
+        let admission = Admission::new(probe.clone(), usize::MAX);
+        admission.owner_failed.store(true, Ordering::SeqCst);
+        let mem = db.get_memory();
+        let root = mem.get_data_root().unwrap().root;
+        drop(
+            mem.get_page(root, crate::tree_store::PageHint::Clean)
+                .unwrap(),
+        );
+        let before = probe.physical_len.load(Ordering::SeqCst);
+        let tx = db
+            .begin_write_with_growth_admission(admission.clone())
+            .unwrap();
+        let allocator = tx.page_allocator();
+        {
+            let mut table = tx.open_table(DATA).unwrap();
+            let mut rejected = false;
+            for key in BASE_ROWS..INSERT_KEY_LIMIT {
+                match table.insert(key, VALUE.as_slice()) {
+                    Ok(_) => {}
+                    Err(StorageError::AdmissionOwnerFailed) => {
+                        rejected = true;
+                        break;
+                    }
+                    Err(error) => panic!("unexpected mutation failure: {error}"),
+                }
+            }
+            assert!(rejected, "bounded workload did not invoke the failed owner");
+        }
+        assert_eq!(admission.owner_failures.lock().unwrap().len(), 1);
+        assert!(admission.denied.lock().unwrap().is_empty());
+        assert!(probe.extensions.lock().unwrap().is_empty());
+        assert_eq!(probe.physical_len.load(Ordering::SeqCst), before);
+        assert!(matches!(
+            allocator.allocate(512, &crate::tree_store::PageTracker::ignore()),
+            Err(StorageError::AdmissionOwnerFailed)
+        ));
+        assert!(matches!(
+            mem.get_page(root, crate::tree_store::PageHint::Clean),
+            Err(StorageError::AdmissionOwnerFailed)
+        ));
+        // Restoring the callback cannot repair this database's recorded failure.
+        admission.owner_failed.store(false, Ordering::SeqCst);
+        if explicit_commit {
+            assert!(matches!(
+                tx.commit(),
+                Err(CommitError::Storage(StorageError::AdmissionOwnerFailed))
+            ));
+        } else {
+            drop(tx);
+        }
+        drop(allocator);
+        drop(admission);
+        assert!(matches!(
+            db.begin_write(),
+            Err(TransactionError::Storage(
+                StorageError::AdmissionOwnerFailed
+            ))
+        ));
+        let replacement = Admission::new(probe.clone(), usize::MAX);
+        assert!(matches!(
+            db.begin_write_with_growth_admission(replacement.clone()),
+            Err(TransactionError::Storage(
+                StorageError::AdmissionOwnerFailed
+            ))
+        ));
+        assert!(replacement.approved.lock().unwrap().is_empty());
+        assert!(matches!(
+            db.begin_read(),
+            Err(TransactionError::Storage(
+                StorageError::AdmissionOwnerFailed
+            ))
+        ));
+        probe.enforce.store(false, Ordering::SeqCst);
+        drop(mem);
+        drop(db);
+        assert_baseline(&reopen(&path, REGION_BYTES));
+    }
+}
