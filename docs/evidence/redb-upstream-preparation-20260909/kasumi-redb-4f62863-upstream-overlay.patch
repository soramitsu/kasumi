+#[test]
+fn admitted_begin_rejects_volatile_state_without_adoption_and_releases_writer() {
+    let (db, _path, probe) = fixture();
+    let mut pending = db.begin_write().unwrap();
+    pending.set_durability(crate::Durability::None).unwrap();
+    pending
+        .open_table(DATA)
+        .unwrap()
+        .insert(0, b"volatile".as_slice())
+        .unwrap();
+    pending.commit().unwrap();
+    let read = db.begin_read().unwrap();
+    assert_eq!(
+        read.open_table(DATA)
+            .unwrap()
+            .get(0)
+            .unwrap()
+            .unwrap()
+            .value(),
+        b"volatile"
+    );
+    let result = db.begin_write_with_growth_admission(Admission::new(probe.clone(), 0));
+    assert!(matches!(
+        result,
+        Err(TransactionError::UnsupportedGrowthAdmission(
+            crate::UnsupportedGrowthAdmission::VolatileState
+        ))
+    ));
+    assert_eq!(
+        read.open_table(DATA)
+            .unwrap()
+            .get(0)
+            .unwrap()
+            .unwrap()
+            .value(),
+        b"volatile"
+    );
+    drop(read);
+    // Only an ordinary explicit durable checkpoint may resolve that unsupported state.
+    probe.enforce.store(false, Ordering::SeqCst);
+    let mut checkpoint = db.begin_write().unwrap();
+    checkpoint.disable_post_commit_free();
+    checkpoint.commit().unwrap();
+    let admitted = db
+        .begin_write_with_growth_admission(Admission::new(probe.clone(), 0))
+        .unwrap();
+    admitted.abort().unwrap();
+    probe.enforce.store(false, Ordering::SeqCst);
+}
