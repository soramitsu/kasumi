diff --git a/src/growth_admission.rs b/src/growth_admission.rs
new file mode 100644
index 0000000..957f7b2
--- /dev/null
+++ b/src/growth_admission.rs
@@ -0,0 +1,144 @@
+use crate::sync::Mutex;
+use crate::{Result, StorageError};
+use alloc::sync::Arc;
+use core::fmt::{Debug, Display, Formatter};
+
+/// The exact file extent whose growth was denied, before the resize was issued.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct CapacityExceeded {
+    pub current_len: u64,
+    pub requested_len: u64,
+}
+
+impl Display for CapacityExceeded {
+    fn fmt(&self, f: &mut Formatter<'_>) -> core::fmt::Result {
+        write!(
+            f,
+            "File growth from {} to {} bytes was denied",
+            self.current_len, self.requested_len
+        )
+    }
+}
+
+/// A mode whose shared effects do not yet have a rollback-valid admitted plan.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum UnsupportedGrowthAdmission {
+    /// A pending non-durable commit or post-commit epilogue owns volatile state.
+    VolatileState,
+    /// Admitted writes currently require immediate durability.
+    NonDurable,
+    /// Savepoint restore is not supported in an admitted transaction.
+    SavepointRestore,
+}
+
+impl Display for UnsupportedGrowthAdmission {
+    fn fmt(&self, f: &mut Formatter<'_>) -> core::fmt::Result {
+        f.write_str(match self {
+            Self::VolatileState => {
+                "Growth admission cannot adopt pending volatile transaction state"
+            }
+            Self::NonDurable => "Growth admission requires immediate durability",
+            Self::SavepointRestore => "Growth admission does not support savepoint restore",
+        })
+    }
+}
+
+/// Why the installed owner could not admit an exact extension.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum GrowthAdmissionError {
+    /// The owner is healthy, but its ordinary capacity budget cannot fit the extent.
+    CapacityDenied,
+    /// Ownership, accounting or physical storage is failed or uncertain.
+    /// This permanently closes the current database, not just this transaction.
+    OwnerFailed,
+}
+
+/// Experimental transaction growth admission, not a complete disk-capacity contract.
+///
+/// Called before a transaction extends its file, including allocations during commit.
+/// `Ok(())` must reserve the exact extension before returning. The owner must retain
+/// that charge independently of this transaction and database handle. redb never
+/// releases it on abort, drop, or an uncertain backend failure. Reclamation requires
+/// separately verified physical truncation/deletion and ownership drain.
+///
+/// Open, close, repair, compaction, and transactions started with `begin_write` do
+/// not use this owner. Admitted transactions support immediate durability, including
+/// quick repair, and roll back capacity denials during private commit preparation.
+/// They reject pending volatile state, non-durable mode, and savepoint restore.
+/// Reclamation is prepared by a later durable transaction rather than an allocating
+/// epilogue; admitted commits do not trim the file. Actual I/O or publication failures
+/// still require reopening. Callbacks must not panic or reenter redb.
+/// `OwnerFailed` is never an ordinary capacity denial or proof of rollback. It
+/// closes new transaction and page access on this database even if the callback is
+/// replaced. Previously issued values and table/cursor fast paths are not revoked;
+/// the embedding service must fence response release and drain their owners.
+/// This API is a prototype and must not be used as production disk admission.
+pub trait GrowthAdmission: Debug + Send + Sync + 'static {
+    fn reserve_growth(
+        &self,
+        current_len: u64,
+        requested_len: u64,
+    ) -> core::result::Result<(), GrowthAdmissionError>;
+}
+
+#[derive(Clone, Copy)]
+enum Failure {
+    Capacity(CapacityExceeded),
+    Owner,
+}
+
+#[derive(Default)]
+pub(crate) struct GrowthState {
+    admission: Option<Arc<dyn GrowthAdmission>>,
+    failure: Mutex<Option<Failure>>,
+}
+
+impl GrowthState {
+    pub(crate) fn new(admission: Option<Arc<dyn GrowthAdmission>>) -> Self {
+        Self {
+            admission,
+            failure: Mutex::new(None),
+        }
+    }
+
+    pub(crate) fn is_admitted(&self) -> bool {
+        self.admission.is_some()
+    }
+
+    pub(crate) fn capacity_failure(&self) -> Option<CapacityExceeded> {
+        match *self.failure.lock().unwrap() {
+            Some(Failure::Capacity(failure)) => Some(failure),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn check(&self) -> Result {
+        match *self.failure.lock().unwrap() {
+            Some(Failure::Capacity(failure)) => Err(StorageError::CapacityExceeded(failure)),
+            Some(Failure::Owner) => Err(StorageError::AdmissionOwnerFailed),
+            None => Ok(()),
+        }
+    }
+
+    pub(crate) fn reserve(&self, current_len: u64, requested_len: u64) -> Result {
+        self.check()?;
+        if let Some(admission) = &self.admission {
+            match admission.reserve_growth(current_len, requested_len) {
+                Ok(()) => {}
+                Err(GrowthAdmissionError::CapacityDenied) => {
+                    let failure = CapacityExceeded {
+                        current_len,
+                        requested_len,
+                    };
+                    *self.failure.lock().unwrap() = Some(Failure::Capacity(failure));
+                    return Err(StorageError::CapacityExceeded(failure));
+                }
+                Err(GrowthAdmissionError::OwnerFailed) => {
+                    *self.failure.lock().unwrap() = Some(Failure::Owner);
+                    return Err(StorageError::AdmissionOwnerFailed);
+                }
+            }
+        }
+        Ok(())
+    }
+}
diff --git a/src/growth_admission_tests.rs b/src/growth_admission_tests.rs
new file mode 100644
index 0000000..71f10db
--- /dev/null
+++ b/src/growth_admission_tests.rs
@@ -0,0 +1,1033 @@
+use crate::ReadableTable;
+use crate::backends::FileBackend;
+use crate::{
+    CapacityExceeded, CommitError, Database, GrowthAdmission, GrowthAdmissionError,
+    ReadableDatabase, ReadableTableMetadata, StorageBackend, StorageError, TableDefinition,
+    TransactionError,
+};
+use std::io;
+use std::sync::atomic::{AtomicBool, AtomicU8, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+const DATA: TableDefinition<u64, &[u8]> = TableDefinition::new("data");
+const OTHER: TableDefinition<u64, &[u8]> = TableDefinition::new("other");
+const BASE_ROWS: u64 = 128;
+const PAGE_BYTES: usize = 512;
+const REGION_BYTES: u64 = 1024 * 1024;
+const SPLIT_REGION_BYTES: u64 = 16 * 1024;
+const INSERT_KEY_LIMIT: u64 = 20_000;
+const REPLACEMENT_REGION_BYTES: u64 = 16 * 1024 * 1024;
+const MAX_REPLACEMENT_BYTES: usize = 8 * 1024 * 1024;
+const VALUE: [u8; 80] = [0x35; 80];
+const SET_LEN: u8 = 1;
+const SYNC: u8 = 2;
+const WRITE: u8 = 3;
+
+#[derive(Debug, Default)]
+struct Probe {
+    physical_len: AtomicU64,
+    reserved_extent: AtomicU64,
+    enforce: AtomicBool,
+    fail: AtomicU8,
+    extensions: Mutex<Vec<(u64, u64)>>,
+}
+
+#[derive(Debug)]
+struct ObservedBackend {
+    file: FileBackend,
+    probe: Arc<Probe>,
+}
+
+impl ObservedBackend {
+    fn fail_if(&self, operation: u8) -> io::Result<()> {
+        if self.probe.fail.load(Ordering::SeqCst) == operation {
+            Err(io::Error::other("injected actual backend failure"))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl StorageBackend for ObservedBackend {
+    fn len(&self) -> io::Result<u64> {
+        self.file.len()
+    }
+
+    fn read(&self, offset: u64, out: &mut [u8]) -> io::Result<()> {
+        self.file.read(offset, out)
+    }
+
+    fn set_len(&self, len: u64) -> io::Result<()> {
+        let old = self.file.len()?;
+        if len > old {
+            if self.probe.enforce.load(Ordering::SeqCst) {
+                assert!(self.probe.reserved_extent.load(Ordering::SeqCst) >= len);
+            }
+            self.probe.extensions.lock().unwrap().push((old, len));
+        }
+        self.fail_if(SET_LEN)?;
+        self.file.set_len(len)?;
+        self.probe.physical_len.store(len, Ordering::SeqCst);
+        Ok(())
+    }
+
+    fn sync_data(&self) -> io::Result<()> {
+        self.fail_if(SYNC)?;
+        self.file.sync_data()
+    }
+
+    fn write(&self, offset: u64, data: &[u8]) -> io::Result<()> {
+        self.fail_if(WRITE)?;
+        self.file.write(offset, data)
+    }
+
+    fn close(&self) -> io::Result<()> {
+        self.file.close()
+    }
+}
+
+#[derive(Debug)]
+struct Admission {
+    probe: Arc<Probe>,
+    permits_left: AtomicUsize,
+    approved: Mutex<Vec<(u64, u64)>>,
+    denied: Mutex<Vec<CapacityExceeded>>,
+    owner_failed: AtomicBool,
+    owner_failures: Mutex<Vec<CapacityExceeded>>,
+}
+
+impl Admission {
+    fn new(probe: Arc<Probe>, permits: usize) -> Arc<Self> {
+        probe
+            .reserved_extent
+            .store(probe.physical_len.load(Ordering::SeqCst), Ordering::SeqCst);
+        probe.extensions.lock().unwrap().clear();
+        probe.enforce.store(true, Ordering::SeqCst);
+        Arc::new(Self {
+            probe,
+            permits_left: AtomicUsize::new(permits),
+            approved: Mutex::new(Vec::new()),
+            denied: Mutex::new(Vec::new()),
+            owner_failed: AtomicBool::new(false),
+            owner_failures: Mutex::new(Vec::new()),
+        })
+    }
+}
+
+impl GrowthAdmission for Admission {
+    fn reserve_growth(
+        &self,
+        current_len: u64,
+        requested_len: u64,
+    ) -> Result<(), GrowthAdmissionError> {
+        assert_eq!(current_len, self.probe.physical_len.load(Ordering::SeqCst));
+        assert!(requested_len > current_len);
+        if self.owner_failed.load(Ordering::SeqCst) {
+            self.owner_failures.lock().unwrap().push(CapacityExceeded {
+                current_len,
+                requested_len,
+            });
+            return Err(GrowthAdmissionError::OwnerFailed);
+        }
+        if self
+            .permits_left
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |left| {
+                left.checked_sub(1)
+            })
+            .is_err()
+        {
+            self.denied.lock().unwrap().push(CapacityExceeded {
+                current_len,
+                requested_len,
+            });
+            return Err(GrowthAdmissionError::CapacityDenied);
+        }
+        self.approved
+            .lock()
+            .unwrap()
+            .push((current_len, requested_len));
+        self.probe
+            .reserved_extent
+            .fetch_max(requested_len, Ordering::SeqCst);
+        Ok(())
+    }
+}
