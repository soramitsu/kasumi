+        .unwrap();
+    let savepoint = tx.ephemeral_savepoint().unwrap();
+    assert!(matches!(
+        tx.set_durability(crate::Durability::None),
+        Err(crate::SetDurabilityError::UnsupportedGrowthAdmission(
