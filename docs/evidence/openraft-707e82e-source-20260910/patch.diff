+/// Failures observed after both the core and ticker tasks have joined.
+///
+/// The two outcomes are retained independently: a core failure never skips the
+/// ticker join or conceals a second failure. Repeated shutdown calls return the
+/// same observed outcomes.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+#[error("raft shutdown failed (core: {core:?}, ticker: {ticker:?})")]
