+impl<NID: NodeId> ShutdownError<NID> {
+    /// The core task's unexpected terminal failure, if any.
+    pub fn core(&self) -> Option<&Fatal<NID>> {
+        self.core.as_ref()
+    }
+
+    /// The ticker task's unexpected terminal failure, if any.
+    pub fn ticker(&self) -> Option<&Fatal<NID>> {
+        self.ticker.as_ref()
+    }
+}
