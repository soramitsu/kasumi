+    }
+    impl RaftCapacityProvider<UTConfig> for Gate {
+        fn prepare_append(&self, previous: Option<&LogId<u64>>, entries: &[Entry<UTConfig>]) -> CapacityPreparation {
+            self.observed.lock().unwrap().push((previous.cloned(), entries[0].log_id));
+            if self.refuse.load(Ordering::SeqCst) {
+                CapacityPreparation::Refused(Box::new(std::io::Error::other("original prospective refusal")))
+            } else {
+                CapacityPreparation::Ready(PreparedCapacity::new(()))
+            }
+        }
+    }
