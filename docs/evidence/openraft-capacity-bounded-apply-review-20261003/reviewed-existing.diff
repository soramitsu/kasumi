+    let error = engine.leader_handler()?.leader_append_entries(proposal()).unwrap_err();
+    assert_eq!(engine.state.last_log_id(), previous.as_ref());
+    assert_eq!(engine.leader.as_ref().unwrap().last_log_id(), previous.as_ref());
+    assert!(engine.output.append_capacity.is_none());
+    let CapacityRejected::Refused(original) = error else {
+        panic!("actual refusal expected")
+    };
+    original.inspect(&mut |error| {
+        assert!(error.unwrap().downcast_ref::<std::io::Error>().is_some());
+        // Reading an original known-unaccepted error must not block the actor.
+        assert!(!slot.available());
