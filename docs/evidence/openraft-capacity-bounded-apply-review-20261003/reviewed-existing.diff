+    assert_eq!(observed.len(), 2);
+    assert_eq!(observed[0], observed[1]);
+    assert_eq!(engine.state.last_log_id(), Some(&observed[1].1));
+    drop(observed);
+    engine.output.take_commands();
+    assert!(!slot.retained());
+    drop(engine);
+    assert!(matches!(
+        slot.close(),
+        crate::storage::capacity::CapacitySlotClose::Closed
+    ));
+    Ok(())
+}
