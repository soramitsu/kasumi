+#[test]
+fn explicit_abort_and_drop_after_capacity_denial_leave_database_usable() {
+    for explicit in [false, true] {
+        let (db, path, probe) = fixture();
+        let admission = Admission::new(probe.clone(), 1);
+        let tx = db.begin_write_with_growth_admission(admission).unwrap();
+        fill_until_denied(&mut tx.open_table(DATA).unwrap());
+        let extent = probe.reserved_extent.load(Ordering::SeqCst);
+        if explicit {
+            tx.abort().unwrap();
+        } else {
+            drop(tx);
+        }
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), extent);
+        assert_baseline(&db);
+        probe.enforce.store(false, Ordering::SeqCst);
+        db.begin_write().unwrap().abort().unwrap();
+        drop(db);
+        assert_baseline(&reopen(&path, REGION_BYTES));
+    }
+}
