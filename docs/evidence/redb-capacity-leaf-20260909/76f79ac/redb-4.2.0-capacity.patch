+use crate::ReadableTable;
+use crate::backends::FileBackend;
+use crate::{
+    CapacityExceeded, CommitError, Database, GrowthAdmission, GrowthDenied, ReadableDatabase,
+    ReadableTableMetadata, StorageBackend, StorageError, TableDefinition, TransactionError,
+};
+use std::io;
+use std::sync::atomic::{AtomicBool, AtomicU8, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+const DATA: TableDefinition<u64, &[u8]> = TableDefinition::new("data");
+const OTHER: TableDefinition<u64, &[u8]> = TableDefinition::new("other");
+const BASE_ROWS: u64 = 128;
+const PAGE_BYTES: usize = 512;
+const REGION_BYTES: u64 = 1024 * 1024;
+const SPLIT_REGION_BYTES: u64 = 16 * 1024;
+const INSERT_KEY_LIMIT: u64 = 20_000;
+const REPLACEMENT_REGION_BYTES: u64 = 16 * 1024 * 1024;
+const MAX_REPLACEMENT_BYTES: usize = 8 * 1024 * 1024;
+const VALUE: [u8; 80] = [0x35; 80];
+const SET_LEN: u8 = 1;
+const SYNC: u8 = 2;
+const WRITE: u8 = 3;
+
+#[derive(Debug, Default)]
+struct Probe {
+    physical_len: AtomicU64,
+    reserved_extent: AtomicU64,
+    enforce: AtomicBool,
+    fail: AtomicU8,
+    extensions: Mutex<Vec<(u64, u64)>>,
+}
+
+#[derive(Debug)]
+struct ObservedBackend {
+    file: FileBackend,
+    probe: Arc<Probe>,
+}
+
+impl ObservedBackend {
+    fn fail_if(&self, operation: u8) -> io::Result<()> {
+        if self.probe.fail.load(Ordering::SeqCst) == operation {
+            Err(io::Error::other("injected actual backend failure"))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl StorageBackend for ObservedBackend {
+    fn len(&self) -> io::Result<u64> {
+        self.file.len()
+    }
+
+    fn read(&self, offset: u64, out: &mut [u8]) -> io::Result<()> {
+        self.file.read(offset, out)
+    }
+
+    fn set_len(&self, len: u64) -> io::Result<()> {
+        let old = self.file.len()?;
+        if len > old {
+            if self.probe.enforce.load(Ordering::SeqCst) {
+                assert!(self.probe.reserved_extent.load(Ordering::SeqCst) >= len);
+            }
+            self.probe.extensions.lock().unwrap().push((old, len));
+        }
+        self.fail_if(SET_LEN)?;
+        self.file.set_len(len)?;
+        self.probe.physical_len.store(len, Ordering::SeqCst);
+        Ok(())
+    }
+
+    fn sync_data(&self) -> io::Result<()> {
+        self.fail_if(SYNC)?;
+        self.file.sync_data()
+    }
+
+    fn write(&self, offset: u64, data: &[u8]) -> io::Result<()> {
+        self.fail_if(WRITE)?;
+        self.file.write(offset, data)
+    }
+
+    fn close(&self) -> io::Result<()> {
+        self.file.close()
+    }
+}
+
+#[derive(Debug)]
+struct Admission {
+    probe: Arc<Probe>,
+    permits_left: AtomicUsize,
+    approved: Mutex<Vec<(u64, u64)>>,
+    denied: Mutex<Vec<CapacityExceeded>>,
+}
+
+impl Admission {
+    fn new(probe: Arc<Probe>, permits: usize) -> Arc<Self> {
+        probe
+            .reserved_extent
+            .store(probe.physical_len.load(Ordering::SeqCst), Ordering::SeqCst);
+        probe.extensions.lock().unwrap().clear();
+        probe.enforce.store(true, Ordering::SeqCst);
+        Arc::new(Self {
+            probe,
+            permits_left: AtomicUsize::new(permits),
+            approved: Mutex::new(Vec::new()),
+            denied: Mutex::new(Vec::new()),
+        })
+    }
+}
+
+impl GrowthAdmission for Admission {
+    fn reserve_growth(&self, current_len: u64, requested_len: u64) -> Result<(), GrowthDenied> {
+        assert_eq!(current_len, self.probe.physical_len.load(Ordering::SeqCst));
+        assert!(requested_len > current_len);
+        if self
+            .permits_left
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |left| {
+                left.checked_sub(1)
+            })
+            .is_err()
+        {
+            self.denied.lock().unwrap().push(CapacityExceeded {
+                current_len,
+                requested_len,
+            });
+            return Err(GrowthDenied);
+        }
+        self.approved
+            .lock()
+            .unwrap()
+            .push((current_len, requested_len));
+        self.probe
+            .reserved_extent
+            .fetch_max(requested_len, Ordering::SeqCst);
+        Ok(())
+    }
+}
+
+fn fixture() -> (Database, tempfile::TempPath, Arc<Probe>) {
+    fixture_with_region(REGION_BYTES)
+}
+
+fn fixture_with_region(region_bytes: u64) -> (Database, tempfile::TempPath, Arc<Probe>) {
+    let (file, path) = crate::create_tempfile().into_parts();
+    let probe = Arc::new(Probe::default());
+    let db = Database::builder()
+        .set_page_size(PAGE_BYTES)
+        .set_region_size(region_bytes)
+        .set_cache_size(1024 * 1024)
+        .create_with_backend(ObservedBackend {
+            file: FileBackend::new(file).unwrap(),
+            probe: probe.clone(),
+        })
+        .unwrap();
+    let mut tx = db.begin_write().unwrap();
+    tx.disable_post_commit_free();
+    {
+        let mut table = tx.open_table(DATA).unwrap();
+        for key in 0..BASE_ROWS {
+            table.insert(key, VALUE.as_slice()).unwrap();
+        }
+        assert!(table.stats().unwrap().branch_pages() > 0);
+        tx.open_table(OTHER)
+            .unwrap()
+            .insert(0, VALUE.as_slice())
+            .unwrap();
+    }
+    tx.commit().unwrap();
+    (db, path, probe)
+}
+
+fn reopen(path: &std::path::Path, region_bytes: u64) -> Database {
+    Database::builder()
+        .set_page_size(PAGE_BYTES)
+        .set_region_size(region_bytes)
+        .open(path)
+        .unwrap()
+}
+
+fn assert_baseline(db: &Database) {
+    let read = db.begin_read().unwrap();
+    let table = read.open_table(DATA).unwrap();
+    assert_eq!(table.len().unwrap(), BASE_ROWS);
+    for key in 0..BASE_ROWS {
+        assert_eq!(table.get(key).unwrap().unwrap().value(), VALUE);
+    }
+    let other = read.open_table(OTHER).unwrap();
+    assert_eq!(other.len().unwrap(), 1);
+    assert_eq!(other.get(0).unwrap().unwrap().value(), VALUE);
+}
+
+fn fill_until_denied(table: &mut crate::Table<'_, u64, &[u8]>) -> CapacityExceeded {
+    for key in BASE_ROWS..INSERT_KEY_LIMIT {
+        match table.insert(key, VALUE.as_slice()) {
+            Ok(_) => {}
+            Err(StorageError::CapacityExceeded(failure)) => return failure,
+            Err(error) => panic!("unexpected mutation failure: {error}"),
+        }
+    }
+    panic!("bounded split workload did not reach its growth limit");
+}
+
+#[test]
+fn denied_growth_never_calls_resize_and_caught_error_cannot_commit() {
+    let (db, path, probe) = fixture();
+    let admission = Admission::new(probe.clone(), 0);
+    let before = probe.physical_len.load(Ordering::SeqCst);
+    let tx = db
+        .begin_write_with_growth_admission(admission.clone())
+        .unwrap();
+    let failure;
+    {
+        let mut table = tx.open_table(DATA).unwrap();
+        failure = fill_until_denied(&mut table);
+    }
+    assert_eq!(failure.current_len, before);
+    assert!(probe.extensions.lock().unwrap().is_empty());
+    assert_eq!(probe.physical_len.load(Ordering::SeqCst), before);
+    assert!(matches!(tx.commit(), Err(CommitError::CapacityAborted(actual)) if actual == failure));
+    assert_baseline(&db);
+    probe.enforce.store(false, Ordering::SeqCst);
+    // The denial is transaction-local: new writes remain available before reopen.
+    let tx = db.begin_write().unwrap();
+    tx.open_table(DATA)
+        .unwrap()
+        .insert(0, VALUE.as_slice())
+        .unwrap();
+    tx.commit().unwrap();
+    drop(db);
+    assert_baseline(&reopen(&path, REGION_BYTES));
+}
+
+#[test]
+fn split_failures_preserve_pinned_roots_and_successful_extent_charges() {
+    // Deny different later growth points in a branching tree after successful splits.
+    for allowed in 1..=4 {
+        let (db, path, probe) = fixture_with_region(SPLIT_REGION_BYTES);
+        let initial_extent = probe.physical_len.load(Ordering::SeqCst);
+        assert!(initial_extent >= SPLIT_REGION_BYTES + u64::try_from(PAGE_BYTES).unwrap());
+        // With a full region already present, grow() adds at most two regions.
+        // Even ignoring all keys/metadata, the bounded workload's values cannot
+        // fit after any of these permitted extensions.
+        let maximum_extent = initial_extent
+            .checked_add(
+                SPLIT_REGION_BYTES
+                    .checked_mul(2)
+                    .unwrap()
+                    .checked_mul(u64::try_from(allowed).unwrap())
+                    .unwrap(),
+            )
+            .unwrap();
+        let workload_bytes = (INSERT_KEY_LIMIT - BASE_ROWS)
+            .checked_mul(u64::try_from(VALUE.len()).unwrap())
+            .unwrap();
+        assert!(maximum_extent < workload_bytes);
+        let pinned = db.begin_read().unwrap();
+        let pinned_table = pinned.open_table(DATA).unwrap();
+        let admission = Admission::new(probe.clone(), allowed);
+        let tx = db
+            .begin_write_with_growth_admission(admission.clone())
+            .unwrap();
+        let failure = fill_until_denied(&mut tx.open_table(DATA).unwrap());
+        assert_eq!(admission.approved.lock().unwrap().len(), allowed);
+        assert_eq!(
+            *probe.extensions.lock().unwrap(),
+            *admission.approved.lock().unwrap()
+        );
+        let grown = probe.physical_len.load(Ordering::SeqCst);
+        assert_eq!(grown, failure.current_len);
+        assert!(grown <= maximum_extent);
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), grown);
+        assert!(
+            matches!(tx.commit(), Err(CommitError::CapacityAborted(actual)) if actual == failure)
+        );
+        assert_eq!(probe.physical_len.load(Ordering::SeqCst), grown);
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), grown);
+        assert_eq!(pinned_table.len().unwrap(), BASE_ROWS);
+        for key in 0..BASE_ROWS {
+            assert_eq!(pinned_table.get(key).unwrap().unwrap().value(), VALUE);
+        }
+        assert_baseline(&db);
+        drop(pinned_table);
+        drop(pinned);
+        probe.enforce.store(false, Ordering::SeqCst);
+        drop(db);
+        // Closing can physically trim through the unresolved maintenance path;
+        // dropping the transaction or database never releases the external charge.
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), grown);
+        assert_baseline(&reopen(&path, SPLIT_REGION_BYTES));
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), grown);
+    }
+}
+
+#[test]
+fn replacement_denial_aborts_all_tables_and_retains_original_value() {
+    let (db, path, probe) = fixture_with_region(REPLACEMENT_REGION_BYTES);
+    let admission = Admission::new(probe.clone(), usize::MAX);
+    let tx = db
+        .begin_write_with_growth_admission(admission.clone())
+        .unwrap();
+    let failure;
+    {
+        let mut other = tx.open_table(OTHER).unwrap();
+        other.insert(0, b"tentative".as_slice()).unwrap();
+        admission.permits_left.store(0, Ordering::SeqCst);
+        let mut data = tx.open_table(DATA).unwrap();
+        // A single replacement larger than the actual file cannot fit in any
+        // currently allocated extent. Bound the fixture before allocating it.
+        let replacement_bytes = usize::try_from(
+            probe
+                .physical_len
+                .load(Ordering::SeqCst)
+                .checked_add(1)
+                .unwrap(),
+        )
+        .unwrap();
+        assert!(replacement_bytes <= MAX_REPLACEMENT_BYTES);
+        let replacement = vec![0x61; replacement_bytes];
+        failure = match data.insert(0, replacement.as_slice()) {
+            Err(StorageError::CapacityExceeded(failure)) => failure,
+            Err(error) => panic!("unexpected replacement error: {error}"),
+            Ok(_) => panic!("expected replacement growth denial"),
+        };
+        // This page is already dirty. The mutable-page path must observe the
+        // same failure as the allocator for the other table.
+        assert!(
+            matches!(other.insert(0, b"changed".as_slice()), Err(StorageError::CapacityExceeded(actual)) if actual == failure)
+        );
+    }
+    assert!(matches!(tx.commit(), Err(CommitError::CapacityAborted(actual)) if actual == failure));
+    probe.enforce.store(false, Ordering::SeqCst);
+    assert_baseline(&db);
+    drop(db);
+    assert_baseline(&reopen(&path, REPLACEMENT_REGION_BYTES));
+}
