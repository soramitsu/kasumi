+use crate::sync::Mutex;
+use crate::{Result, StorageError};
+use alloc::sync::Arc;
+use core::fmt::{Debug, Display, Formatter};
+
+/// The exact file extent whose growth was denied, before the resize was issued.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct CapacityExceeded {
+    pub current_len: u64,
+    pub requested_len: u64,
+}
+
+impl Display for CapacityExceeded {
+    fn fmt(&self, f: &mut Formatter<'_>) -> core::fmt::Result {
+        write!(
+            f,
+            "File growth from {} to {} bytes was denied",
+            self.current_len, self.requested_len
+        )
+    }
+}
+
+/// A mode whose shared effects do not yet have a rollback-valid admitted plan.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum UnsupportedGrowthAdmission {
+    /// A pending non-durable commit or post-commit epilogue owns volatile state.
+    VolatileState,
+    /// Admitted writes currently require immediate durability.
+    NonDurable,
+    /// Savepoint restore is not supported in an admitted transaction.
+    SavepointRestore,
+}
+
+impl Display for UnsupportedGrowthAdmission {
+    fn fmt(&self, f: &mut Formatter<'_>) -> core::fmt::Result {
+        f.write_str(match self {
+            Self::VolatileState => {
+                "Growth admission cannot adopt pending volatile transaction state"
+            }
+            Self::NonDurable => "Growth admission requires immediate durability",
+            Self::SavepointRestore => "Growth admission does not support savepoint restore",
+        })
+    }
+}
+
+/// The admission owner did not reserve the requested extent.
+#[derive(Clone, Copy, Debug)]
+pub struct GrowthDenied;
+
+/// Experimental transaction growth admission, not a complete disk-capacity contract.
+///
+/// Called before a transaction extends its file, including allocations during commit.
+/// `Ok(())` must reserve the exact extension before returning. The owner must retain
+/// that charge independently of this transaction and database handle. redb never
+/// releases it on abort, drop, or an uncertain backend failure. Reclamation requires
+/// separately verified physical truncation/deletion and ownership drain.
+///
+/// Open, close, repair, compaction, and transactions started with `begin_write` do
+/// not use this owner. Admitted transactions support immediate durability, including
+/// quick repair, and roll back capacity denials during private commit preparation.
+/// They reject pending volatile state, non-durable mode, and savepoint restore.
+/// Reclamation is prepared by a later durable transaction rather than an allocating
+/// epilogue; admitted commits do not trim the file. Actual I/O or publication failures
+/// still require reopening. Callbacks must not panic or reenter redb.
+/// This API is a prototype and must not be used as production disk admission.
+pub trait GrowthAdmission: Debug + Send + Sync + 'static {
+    fn reserve_growth(
+        &self,
+        current_len: u64,
+        requested_len: u64,
+    ) -> core::result::Result<(), GrowthDenied>;
+}
+
+#[derive(Default)]
+pub(crate) struct GrowthState {
+    admission: Option<Arc<dyn GrowthAdmission>>,
+    failure: Mutex<Option<CapacityExceeded>>,
+}
+
+impl GrowthState {
+    pub(crate) fn new(admission: Option<Arc<dyn GrowthAdmission>>) -> Self {
+        Self {
+            admission,
+            failure: Mutex::new(None),
+        }
+    }
+
+    pub(crate) fn is_admitted(&self) -> bool {
+        self.admission.is_some()
+    }
+
+    pub(crate) fn failure(&self) -> Option<CapacityExceeded> {
+        *self.failure.lock().unwrap()
+    }
+
+    pub(crate) fn check(&self) -> Result {
+        match self.failure() {
+            Some(failure) => Err(StorageError::CapacityExceeded(failure)),
+            None => Ok(()),
+        }
+    }
+
+    pub(crate) fn reserve(&self, current_len: u64, requested_len: u64) -> Result {
+        self.check()?;
+        if let Some(admission) = &self.admission
+            && admission
+                .reserve_growth(current_len, requested_len)
+                .is_err()
+        {
+            let failure = CapacityExceeded {
+                current_len,
+                requested_len,
+            };
+            *self.failure.lock().unwrap() = Some(failure);
+            return Err(StorageError::CapacityExceeded(failure));
+        }
+        Ok(())
+    }
+}
