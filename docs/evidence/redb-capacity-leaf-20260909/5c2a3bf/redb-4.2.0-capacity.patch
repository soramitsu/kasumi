+#[test]
+fn split_failures_preserve_pinned_roots_and_successful_extent_charges() {
+    // Deny different later growth points in a branching tree after successful splits.
+    for allowed in 1..=4 {
+        let (db, path, probe) = fixture_with_region(SPLIT_REGION_BYTES);
+        let initial_extent = probe.physical_len.load(Ordering::SeqCst);
+        assert!(initial_extent >= SPLIT_REGION_BYTES + u64::try_from(PAGE_BYTES).unwrap());
+        // With a full region already present, grow() adds at most two regions.
+        // Even ignoring all keys/metadata, the bounded workload's values cannot
+        // fit after any of these permitted extensions.
+        let maximum_extent = initial_extent
+            .checked_add(
+                SPLIT_REGION_BYTES
+                    .checked_mul(2)
+                    .unwrap()
+                    .checked_mul(u64::try_from(allowed).unwrap())
+                    .unwrap(),
+            )
+            .unwrap();
+        let workload_bytes = (INSERT_KEY_LIMIT - BASE_ROWS)
+            .checked_mul(u64::try_from(VALUE.len()).unwrap())
+            .unwrap();
+        assert!(maximum_extent < workload_bytes);
+        let pinned = db.begin_read().unwrap();
+        let pinned_table = pinned.open_table(DATA).unwrap();
+        let admission = Admission::new(probe.clone(), allowed);
+        let tx = db
+            .begin_write_with_growth_admission(admission.clone())
+            .unwrap();
+        let failure = fill_until_denied(&mut tx.open_table(DATA).unwrap());
+        assert_eq!(admission.approved.lock().unwrap().len(), allowed);
+        assert_eq!(
+            *probe.extensions.lock().unwrap(),
+            *admission.approved.lock().unwrap()
+        );
+        let grown = probe.physical_len.load(Ordering::SeqCst);
+        assert_eq!(grown, failure.current_len);
+        assert!(grown <= maximum_extent);
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), grown);
+        assert!(
+            matches!(tx.commit(), Err(CommitError::CapacityAborted(actual)) if actual == failure)
+        );
+        assert_eq!(probe.physical_len.load(Ordering::SeqCst), grown);
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), grown);
+        assert_eq!(pinned_table.len().unwrap(), BASE_ROWS);
+        for key in 0..BASE_ROWS {
+            assert_eq!(pinned_table.get(key).unwrap().unwrap().value(), VALUE);
+        }
+        assert_baseline(&db);
+        drop(pinned_table);
+        drop(pinned);
+        probe.enforce.store(false, Ordering::SeqCst);
+        drop(db);
+        // Closing can physically trim through the unresolved maintenance path;
+        // dropping the transaction or database never releases the external charge.
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), grown);
+        assert_baseline(&reopen(&path, SPLIT_REGION_BYTES));
+        assert_eq!(probe.reserved_extent.load(Ordering::SeqCst), grown);
+    }
+}
