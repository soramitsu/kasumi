+#[test]
+fn replacement_denial_aborts_all_tables_and_retains_original_value() {
+    let (db, path, probe) = fixture_with_region(REPLACEMENT_REGION_BYTES);
+    let admission = Admission::new(probe.clone(), usize::MAX);
+    let tx = db
+        .begin_write_with_growth_admission(admission.clone())
+        .unwrap();
+    let failure;
+    {
+        let mut other = tx.open_table(OTHER).unwrap();
+        other.insert(0, b"tentative".as_slice()).unwrap();
+        admission.permits_left.store(0, Ordering::SeqCst);
+        let mut data = tx.open_table(DATA).unwrap();
+        // A single replacement larger than the actual file cannot fit in any
+        // currently allocated extent. Bound the fixture before allocating it.
+        let replacement_bytes = usize::try_from(
+            probe
+                .physical_len
+                .load(Ordering::SeqCst)
+                .checked_add(1)
+                .unwrap(),
+        )
+        .unwrap();
+        assert!(replacement_bytes <= MAX_REPLACEMENT_BYTES);
+        let replacement = vec![0x61; replacement_bytes];
+        failure = match data.insert(0, replacement.as_slice()) {
+            Err(StorageError::CapacityExceeded(failure)) => failure,
+            Err(error) => panic!("unexpected replacement error: {error}"),
+            Ok(_) => panic!("expected replacement growth denial"),
+        };
+        // This page is already dirty. The mutable-page path must observe the
+        // same failure as the allocator for the other table.
+        assert!(
+            matches!(other.insert(0, b"changed".as_slice()), Err(StorageError::CapacityExceeded(actual)) if actual == failure)
+        );
+    }
+    assert!(matches!(tx.commit(), Err(CommitError::CapacityAborted(actual)) if actual == failure));
+    probe.enforce.store(false, Ordering::SeqCst);
+    assert_baseline(&db);
+    drop(db);
+    assert_baseline(&reopen(&path, REPLACEMENT_REGION_BYTES));
+}
