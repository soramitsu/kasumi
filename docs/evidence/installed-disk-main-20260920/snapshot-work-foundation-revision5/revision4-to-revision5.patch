+struct ClaimingWake {
+    owner: OwnedOwner<Operation>,
+    output: Mutex<Option<Output>>,
+    calls: AtomicUsize,
+}
+impl std::task::Wake for ClaimingWake {
+    fn wake(self: Arc<Self>) {
+        let work = SnapshotWork {
+            owner: self.owner.clone(),
+        };
+        let output = match work.claim() {
+            Ok(output) => output,
+            Err(_) => panic!("preflight callback must claim the still-owned output"),
+        };
+        self.calls.fetch_add(1, Ordering::AcqRel);
+        assert!(self.output.lock().unwrap().replace(output).is_none());
+    }
+}
