+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn claim_revalidates_after_reentrant_executor_already_claims_the_output() {
+    let node = admission(1);
+    let baseline = node.snapshot().reserved_bytes;
+    let gate = new_gate();
+    let work = prepare(&node, &gate, Outcome::Success);
+    join_only(&work, &gate).await;
+    let report = work.ready().await;
+    let output_id = work
+        .owner
+        .resource
+        .lock()
+        .unwrap()
+        .output
+        .as_ref()
+        .unwrap()
+        ._charge
+        .id;
+    let callback = Arc::new(ClaimingWake {
+        owner: work.owner.clone(),
+        output: Mutex::new(None),
+        calls: AtomicUsize::new(0),
+    });
+    queue_pending_on_unwind(&work.owner.wake, Waker::from(callback.clone()));
+    let denied = match work.claim() {
+        Ok(_) => panic!("outer claim must not deliver the same output twice"),
+        Err(report) => report,
+    };
+    assert_eq!(denied.id(), report.id());
+    assert_eq!(denied.completion(), DrainCompletion::Complete);
+    assert_eq!(callback.calls.load(Ordering::Acquire), 1);
+    let output = callback.output.lock().unwrap().take().unwrap();
+    assert_eq!(output._charge.id, output_id);
+    assert_eq!(gate.output_drops.load(Ordering::Acquire), 0);
+    assert!(node.memory().snapshot_work_at(work.id().slot).is_none());
+    drop(denied);
+    drop(report);
+    drop(callback);
+    drop(work);
+    assert_eq!(node.snapshot().inflight_operations, 0);
+    assert_eq!(
+        node.snapshot().reserved_bytes,
+        baseline + arc_bytes::<Gate>().unwrap()
+    );
+    drop(output);
+    assert_eq!(gate.output_drops.load(Ordering::Acquire), 1);
+    assert_eq!(node.snapshot().reserved_bytes, baseline);
+}
