+    assert!(rendered.contains("cancelled"));
+    assert!(rendered.contains("close also failed"));
+    assert_eq!(streams.outstanding(), 1);
+    assert!(
+        CensusSession::new(
+            &roots,
+            &config,
+            unit,
+            &CensusCancellation::default(),
+            banks.stage(17).unwrap(),
+            &streams
+        )
