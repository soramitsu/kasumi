+struct ProvisionalOwner<T>(Option<Arc<T>>);
+impl<T> ProvisionalOwner<T> {
+    fn new(value: T) -> Self {
+        Self(Some(Arc::new(value)))
+    }
+}
+impl<T> std::ops::Deref for ProvisionalOwner<T> {
