+fn open(config: &NodeDiskConfig, memory: &Arc<TestDiskMemory>) -> Arc<NodeDisk> {
+    retry_disk_registry(|| {
+        NodeDisk::open_fixture(config, memory.clone(), &CensusCancellation::default())
+    })
+    .unwrap()
