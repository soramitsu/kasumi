+/// Authenticate the complete snapshot framing, digest and EOF before selecting
+/// resident semantic bytes. Permanent receipt/terminal rows remain in the image
+/// and are excluded by the same inspected stream model used for admission.
+pub fn snapshot_resident_bytes(candidate: &SnapshotImage) -> Result<u64> {
+    crate::snapshot_codec::inspect(&mut candidate.reader())
+        .and_then(|summary| summary.resident_bytes())
         .map_err(|error| Error::new(ErrorCode::Corruption, error.to_string()))
 }
