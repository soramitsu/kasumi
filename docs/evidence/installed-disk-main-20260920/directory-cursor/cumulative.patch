+    let state = disk.lock_state();
+    assert_eq!(state.files, 8);
+    assert_eq!(state.directories, 2);
+    assert_eq!(state.accounted.len(), 10);
+    drop(state);
+    assert_eq!(
+        disk.create_file(
+            "fixture",
+            std::path::Path::new("overflow"),
