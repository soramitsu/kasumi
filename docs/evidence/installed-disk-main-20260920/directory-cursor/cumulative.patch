+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::StorageFull
+    );
+    assert!(disk.pause().is_err());
+    assert!(disk.reconcile(&CensusCancellation::default()).is_err());
+    release.send(()).unwrap();
+    dropping.join().unwrap();
