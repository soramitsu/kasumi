+#[test]
+fn session_claim_acquires_or_rejects_without_owned_path_allocations() {
+    let temporary = private_tempdir().unwrap();
+    let disk = open(temporary.path(), 2);
+    let first = Directory::open(temporary.path(), disk.clone()).unwrap();
+    let second = Directory::open(temporary.path(), disk.clone()).unwrap();
+    let session = Uuid::from_bytes([0x11; 16]);
+    for (session, slot) in [
+        (Uuid::nil(), BackupSessionSlot::Intent),
+        (session, BackupSessionSlot::Object(Uuid::nil())),
+    ] {
+        let (result, allocations) =
+            crate::allocation_tests::measure(|| first.claim_session_namespace(session, slot));
+        assert_eq!(
+            result.err().unwrap().kind(),
+            std::io::ErrorKind::InvalidInput
+        );
+        assert_eq!(allocations, 0);
+    }
+    let (claim, allocations) = crate::allocation_tests::measure(|| {
+        first.claim_session_namespace(session, BackupSessionSlot::Intent)
+    });
+    let claim = claim.unwrap();
+    assert_eq!(allocations, 0);
+    let (busy, allocations) = crate::allocation_tests::measure(|| {
+        second.claim_session_namespace(session, BackupSessionSlot::Outcome)
+    });
+    assert_eq!(busy.err().unwrap().kind(), std::io::ErrorKind::WouldBlock);
+    assert_eq!(allocations, 0);
+    // The public error conversion has a separate returned-diagnostic lifetime;
+    // contention adds no path allocation beyond that exact conversion.
+    let (_, error_allocations) = crate::allocation_tests::measure(|| {
+        anyhow::Error::from(std::io::Error::from(std::io::ErrorKind::WouldBlock))
+    });
+    let (busy, allocations) = crate::allocation_tests::measure(|| {
+        second.put(session, BackupSessionSlot::Outcome, b"busy")
+    });
+    assert!(busy.is_err());
+    assert_eq!(allocations, error_allocations);
+    assert!(!temporary.path().join("sessions").exists());
+    drop(claim);
+    // A header rejection occurs after claim acquisition and must return the lane.
+    assert!(first.put(session, BackupSessionSlot::Intent, b"").is_err());
+    let claim = second
+        .claim_session_namespace(session, BackupSessionSlot::Intent)
+        .unwrap();
+    drop(claim);
+    assert_eq!(disk.snapshot().phase, crate::NodeDiskPhase::Open);
+}
