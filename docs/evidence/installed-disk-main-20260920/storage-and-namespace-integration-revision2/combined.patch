+            .accounted
+            .iter()
+            .map(|(key, entry)| (*key, *entry))
+            .collect::<std::collections::BTreeMap<_, _>>(),
+        old
+    );
+    assert_eq!(disk.snapshot().phase, NodeDiskPhase::Open);
+}
