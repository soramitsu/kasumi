+fn key_in_group<V>(map: &Map<V>, start: &mut u64, home: u64) -> Identity {
+    // limit40 yields64 physical buckets on both supported group widths.
+    loop {
+        *start += 1;
+        let key = Identity(17, *start);
+        if map.entries.hasher().hash_one(key) & 63 == home {
