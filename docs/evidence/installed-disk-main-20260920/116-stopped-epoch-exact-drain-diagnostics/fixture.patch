+fn inspect_control_stop_drain(
+    fixture: &Fixture,
+    service: &IndependentAuthority,
+    witness: &str,
+    expected: (u64, u64, u64),
+    waiting: bool,
+    result: Result<(SignedControlEpochStop, AuthorityResponseFence)>,
+) -> Result<(SignedControlEpochStop, AuthorityResponseFence)> {
+    let observed = service
+        .drains
+        .lock()
+        .map(|drains| {
+            drains
+                .get(witness)
+                .map(|drain| (drain.term, drain.started, drain.last))
+        })
+        .map_err(|error| error.to_string());
+    let expected_witness = Some((
+        expected.0,
+        Duration::from_millis(expected.1),
+        Duration::from_millis(expected.2),
+    ));
+    let expected_outcome = match (&result, waiting) {
+        (Err(error), true) => {
+            error.code == ErrorCode::Unavailable
+                && error.message == "exact fence drain has not completed; retry the same identity"
+        }
+        (Ok(_), false) => true,
+        _ => false,
+    };
+    assert!(
+        observed == Ok(expected_witness) && expected_outcome,
+        "control stop drain: local={} witness={witness} clock={} expected={expected_witness:?} waiting={waiting} observed={observed:?} error={:?}; members={:?}",
+        service.local_node_id,
+        fixture.clock.0.load(Ordering::SeqCst),
+        result.as_ref().err(),
+        fixture
+            .services
+            .iter()
+            .map(|member| {
+                let metrics = member.group.raft().metrics().borrow().clone();
+                let access = member.group.check_access();
+                format!("metrics={metrics:?}, access={access:?}")
+            })
+            .collect::<Vec<_>>()
+    );
+    result
+}
