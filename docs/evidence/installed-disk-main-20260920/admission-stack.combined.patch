+        struct PanicProbe(std::sync::atomic::AtomicUsize);
+        impl MemorySource for PanicProbe {
+            fn resident_bytes(&self) -> anyhow::Result<u64> {
+                if self.0.fetch_add(1, Ordering::SeqCst) == 1 {
+                    std::panic::panic_any(0x51_u64);
