+    let now = f.context("owner").authorization.expires_at_ms().unwrap() - 60_000;
+    tokio::time::sleep(Duration::from_millis(
+        old_intent
+            .original_credential_expires_at_ms
+            .saturating_sub(now)
+            + 20,
+    ))
+    .await;
+    assert!(
+        db.recovery_phase(f.context("owner"), operation, original_phase)
+            .await
+            .unwrap()
+            .admit_dispatch()
+            .await
+            .is_err()
+    );
