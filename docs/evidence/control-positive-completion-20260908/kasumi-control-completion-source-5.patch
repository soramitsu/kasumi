+        target: t.clone(),
+    }
+    .digest()
+    .unwrap();
+    fresh.observation.intent.request_sha256 = digest(&fresh.observation.intent.request).unwrap();
+    control.sign_intent(&mut fresh);
+    f.clock.0.store(3000, Ordering::SeqCst);
+    assert!(
+        f.epoch.observe().unwrap().utc_ms()
