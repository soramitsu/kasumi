+    let observed_revision = fact.revision;
+    let observation = TargetInspectionObservation {
+        input: *input,
+        inspection_intent: inspection,
+        completion: fact,
+        activation: None,
+        observer_node_id: node_id,
+        observed_revision,
+        observed_term: 8,
