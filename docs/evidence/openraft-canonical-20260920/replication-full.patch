+#[test]
+fn retained_replication_capacity_requires_a_finite_nonzero_bound() {
+    assert_eq!(Config::default().max_retained_replication_owners, 128);
+    for limit in [0, 4097, usize::MAX] {
+        let err = Config {
+            max_retained_replication_owners: limit,
+            ..Default::default()
+        }
+        .validate()
+        .unwrap_err();
+        assert_eq!(err, ConfigError::InvalidRetainedReplicationOwners { limit });
+    }
+    for limit in [1, 128, 4096] {
+        Config {
+            max_retained_replication_owners: limit,
+            ..Default::default()
+        }
+        .validate()
+        .unwrap();
+    }
+}
