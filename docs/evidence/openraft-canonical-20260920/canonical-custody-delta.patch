+/// On both returned errors and unwinding, notify once while the actual incoming
+/// resource is still retained. Pending/cancelled polls carry no failure marker.
+struct IncomingSnapshotGuard<'a, C: RaftTypeConfig> {
+    streaming: &'a mut Option<crate::network::snapshot_transport::Streaming<C>>,
+    notifications: &'a mpsc::UnboundedSender<crate::core::notify::Notify<C>>,
+}
+impl<C: RaftTypeConfig> Drop for IncomingSnapshotGuard<'_, C> {
+    fn drop(&mut self) {
+        if let Some(failure) = self
+            .streaming
+            .as_mut()
+            .and_then(|stream| stream.take_failure_notification())
+        {
+            let _ = self
+                .notifications
+                .send(crate::core::notify::Notify::IncomingSnapshotFailed { error: failure });
+        }
+    }
+}
