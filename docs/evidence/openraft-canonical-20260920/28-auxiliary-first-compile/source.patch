+            ticker: self.ticker.clone(),
+            state_machine: self.state_machine.clone(),
+            snapshot_builder: self.snapshot_builder.clone(),
+            replications: self.replications.clone(),
+            auxiliary: self.auxiliary.clone(),
+        }
+    }
+}
