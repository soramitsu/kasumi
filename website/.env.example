# Copy into Vercel project settings (Production and Preview), never commit real values.
# Public origin of the site; used for Checkout success/cancel URLs and the Origin check.
SITE_URL=https://kasumi.soramitsu.co.jp
# Stripe secret key (sk_live_... in Production, sk_test_... in Preview), or a restricted key
# with write access to Checkout Sessions and read access to Prices and Products.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://kasumi.soramitsu.co.jp/api/webhook
STRIPE_WEBHOOK_SECRET=
# Enable once Stripe Tax has a Japan registration (and any others) in the Dashboard.
STRIPE_AUTOMATIC_TAX=true
# Require the Support Terms checkbox; needs a terms URL in Dashboard > Settings > Public details.
STRIPE_REQUIRE_TERMS=true
# Optional: accept promotion codes created in the Dashboard.
STRIPE_ALLOW_PROMOTION_CODES=false
# Optional: pin a different Stripe API version than lib/stripe.js uses.
STRIPE_API_VERSION=
# Slack-compatible incoming webhook for new-subscription, renewal, cancellation and
# failed-payment notices (no customer names, emails or tax IDs are sent). Required in
# live mode: without it the webhook returns 500 so Stripe shows failing deliveries.
NOTIFY_WEBHOOK_URL=
# Hosts NOTIFY_WEBHOOK_URL may point at (comma-separated). Default: hooks.slack.com
NOTIFY_WEBHOOK_HOSTS=
